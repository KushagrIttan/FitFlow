# Copy to `.env` and fill in your key:
#   cp .env.example .env
#
# RevenueCat *public* SDK key (publishable — safe to bundle in the app).
# Get it from app.revenuecat.com → Project Settings → API keys.
#
# - Debug / testing: Test Store key (`test_...`) — test products work out
#   of the box, no Play Console setup needed.
# - Release / Play: Google platform key (`goog_...`), preferably passed as
#   `--dart-define=REVENUECAT_ANDROID_KEY=goog_...` so the test key never
#   ships (the SDK crashes on purpose with test keys in release builds).
REVENUECAT_ANDROID_KEY=goog_placeholder_put_your_key_here

# NOTE: never put your Gemini API key here. It is entered in-app
# (Settings → AI Stylist) and stored encrypted on-device.
