# Copy to `.env` and fill in your key:
#   cp .env.example .env
#
# RevenueCat *public* SDK key (publishable — safe to bundle in the app).
# Get it from app.revenuecat.com → your project → API keys.
# Android apps use the Google/public key (starts with `goog_...`).
REVENUECAT_ANDROID_KEY=goog_placeholder_put_your_key_here

# NOTE: never put your Gemini API key here. It is entered in-app
# (Settings → AI Stylist) and stored encrypted on-device.
